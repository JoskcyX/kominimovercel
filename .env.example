# ─────────────────────────────────────────────────────────────────────────────
# Kominimo — environment variables
# Copy this file to `.env.local` (local) or set them in your host's dashboard (production).
# NEVER commit real values. Run `npm run check:env` to validate your setup.
#
# Variables prefixed VITE_ are bundled into the browser. Everything else is server-only secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Neon Auth (Managed Better Auth) ──────────────────────────────────────────
# Neon Console → your project → branch → Auth → Configuration → Auth URL
NEON_AUTH_BASE_URL=https://ep-xxxx.neonauth.us-east-2.aws.neon.tech/neondb/auth
VITE_NEON_AUTH_URL=https://ep-xxxx.neonauth.us-east-2.aws.neon.tech/neondb/auth

# ── Neon Postgres ────────────────────────────────────────────────────────────
# Runtime connection (use the POOLED connection string, ideally for the least-privilege
# `app_runtime` role — see docs/SETUP-NEON.md).
DATABASE_URL=postgresql://app_runtime:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Migrations connection (owner role, direct/non-pooled). Only used by `npm run db:migrate`.
DATABASE_URL_MIGRATIONS=postgresql://neondb_owner:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── Neon Object Storage (S3-compatible) ──────────────────────────────────────
# `neon deploy` writes these for you, or create a credential in the Neon Console.
AWS_ENDPOINT_URL_S3=https://xxxx.storage.c-1.us-east-2.aws.neon.tech
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
STORAGE_BUCKET=class-files

# ── Application secrets ──────────────────────────────────────────────────────
# Signs student session tokens. Generate with:  openssl rand -base64 48
SESSION_SECRET=
# Shared secret for scheduled jobs (POST /api/public/jobs/*). Generate the same way.
CRON_SECRET=
# Public origin of the site, no trailing slash. Used for CORS on uploads, sitemap and emails.
APP_URL=http://localhost:3000
VITE_SITE_URL=http://localhost:3000

# ── Live video (Daily.co) ────────────────────────────────────────────────────
DAILY_API_KEY=

# ── Public site details (shown on the Contact / legal pages) ─────────────────
VITE_CONTACT_EMAIL=
VITE_LEGAL_ENTITY=
VITE_LEGAL_ADDRESS=

# ── Optional switches ────────────────────────────────────────────────────────
# Set to "off" to stop enforcing free-plan limits (e.g. while payments aren't live yet).
PLAN_ENFORCEMENT=on
# Set to "true" only if you run behind a trusted proxy that sets x-forwarded-for / cf-connecting-ip.
TRUST_PROXY=true   # true on Vercel (it sets x-forwarded-for)
